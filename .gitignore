# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment Variables (NEVER COMMIT THESE!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
**/.env

# Allow .env.example files (safe templates)
!.env.example
!**/.env.example

# Build outputs
build/
dist/
.tmp/
*.tsbuildinfo

# Logs
logs/
*.log
backend/logs/
backend/logs/*.log

# Backups
backups/
*.backup
*.bak

# Storage (uploaded files, generated PDFs, etc.)
backend/storage/reports/*.pdf
backend/storage/invoices/*.pdf
backend/storage/uploads/*
!backend/storage/reports/.gitkeep
!backend/storage/invoices/.gitkeep
!backend/storage/uploads/.gitkeep

# Test coverage
coverage/
.nyc_output/

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
.cache/

# Database files (if using local SQLite)
*.db
*.sqlite
*.sqlite3

# Misc
*.local
.eslintcache
